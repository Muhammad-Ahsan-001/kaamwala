# Copy to apps/api/.env. Never commit the real file.
NODE_ENV=development
PORT=3002
PUBLIC_API_URL=http://localhost:3002
WEB_ORIGIN=http://localhost:5173

# Matches docker-compose.dev.yml
DATABASE_URL=postgresql://kaamwala:kaamwala_dev_only@localhost:5433/kaamwala

JWT_SECRET=replace-with-a-long-random-string
CNIC_SALT=replace-with-a-different-long-random-string

# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

UPLOAD_DIR=./uploads
