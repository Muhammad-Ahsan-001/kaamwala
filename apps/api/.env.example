# Copy to apps/api/.env. Never commit the real file.
NODE_ENV=development
PORT=3002
PUBLIC_API_URL=http://localhost:3002
WEB_ORIGIN=http://localhost:5173

# Matches docker-compose.dev.yml
DATABASE_URL=postgresql://kaamwala:kaamwala_dev_only@localhost:5433/kaamwala

JWT_SECRET=replace-with-a-long-random-string
CNIC_SALT=replace-with-a-different-long-random-string

# Main AI. Paste your OpenAI key right after the = sign, with no quotes or spaces.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_FALLBACK_MODELS=gpt-4.1-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
OPENAI_TRANSCRIBE_FALLBACK_MODELS=whisper-1

# Backup AI, used only if OpenAI fails. Key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

UPLOAD_DIR=./uploads

# Optional. These are the defaults.
# RATE_LIMIT_JOBS_PER_MIN=60
# RATE_LIMIT_UPLOADS_PER_MIN=30
# RATE_LIMIT_CREWS_PER_MIN=30
# REQUEST_EXPIRY_MINUTES=30
# NEGOTIATION_EXPIRY_MINUTES=720
