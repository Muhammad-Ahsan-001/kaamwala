# Copy to infra/deploy.env, which is git-ignored, and fill in the values.
# This file holds connection details only. API keys go on the server, in
# /etc/kaamwala/api.env (see Deployment in the README).

# Droplet IP address or hostname
DROPLET_HOST=

# SSH user: root, or a user with passwordless sudo
DROPLET_USER=

# Your domain without any subdomain, for example yourdomain.com
# The app will live at kaamwala.<DOMAIN> and api.kaamwala.<DOMAIN>
DOMAIN=

# Optional: SSH port, and the path to a private key if not your default one
SSH_PORT=22
SSH_KEY=

# Optional: only if the droplet's main Caddyfile is somewhere else
CADDY_MAIN_FILE=/etc/caddy/Caddyfile
