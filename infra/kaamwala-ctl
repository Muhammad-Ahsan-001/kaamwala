#!/bin/bash
#
# Root-owned entry point for KaamWala deploys, installed by first-time-setup.sh
# at /usr/local/sbin/kaamwala-ctl. The deploy user may run this one command with
# sudo and no password. It only ever touches KaamWala's own service and files.

set -euo pipefail
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

SERVICE="kaamwala-api"
APP_USER="kaamwala"
ENV_FILE="/etc/kaamwala/api.env"
CURRENT_LINK="/opt/kaamwala/current"
ACTIVATE="/usr/local/lib/kaamwala/remote-activate.sh"

die() {
  echo "ERROR: $*" >&2
  exit 1
}

[[ "${EUID}" -eq 0 ]] || die "Must run as root."

command_name="${1:-}"
shift || true

case "$command_name" in
  activate-sha)
    sha256sum "$ACTIVATE" | cut -d' ' -f1
    ;;

  activate)
    [[ "$#" -eq 3 ]] || die "Usage: kaamwala-ctl activate <release id> <upload dir> <run seed>"
    [[ "$2" =~ ^/tmp/kaamwala-deploy\.[A-Za-z0-9]{6,}$ ]] || die "Unexpected upload directory: $2"
    [[ "$3" == "0" || "$3" == "1" ]] || die "Run seed must be 0 or 1."
    exec bash "$ACTIVATE" "$1" "$2" "$3"
    ;;

  set-env)
    # Reads KEY=value lines on stdin. Values are never printed.
    [[ -f "$ENV_FILE" ]] || die "$ENV_FILE not found."
    merged="$(mktemp)"
    trap 'rm -f "$merged" "$merged.new"' EXIT
    cat "$ENV_FILE" >"$merged"
    pattern='^(GEMINI_API_KEY|GEMINI_MODEL|GEMINI_FALLBACK_MODELS|VAPID_PUBLIC_KEY|VAPID_PRIVATE_KEY)=([A-Za-z0-9._:,/@+=-]*)$'
    count=0
    while IFS= read -r line || [[ -n "$line" ]]; do
      line="${line%$'\r'}"
      [[ -n "$line" ]] || continue
      [[ "$line" =~ $pattern ]] || die "Rejected a line: name or characters are not allowed. Nothing was changed."
      key="${BASH_REMATCH[1]}"
      value="${BASH_REMATCH[2]}"
      if grep -q "^${key}=" "$merged"; then
        KEY="$key" VALUE="$value" awk 'BEGIN { k = ENVIRON["KEY"]; v = ENVIRON["VALUE"] } index($0, k "=") == 1 { print k "=" v; next } { print }' "$merged" >"$merged.new"
        cat "$merged.new" >"$merged"
      else
        printf '%s=%s\n' "$key" "$value" >>"$merged"
      fi
      count=$((count + 1))
    done
    install -o root -g "$APP_USER" -m 640 "$merged" "$ENV_FILE"
    echo "Updated ${count} setting(s)."
    if [[ -L "$CURRENT_LINK" ]]; then
      systemctl restart "$SERVICE"
      echo "Restarted ${SERVICE}."
    fi
    ;;

  restart)
    systemctl restart "$SERVICE"
    ;;

  status)
    systemctl status "$SERVICE" --no-pager --lines=0 || true
    ;;

  logs)
    lines="${1:-100}"
    [[ "$lines" =~ ^[0-9]{1,4}$ ]] || die "Line count must be a number up to 9999."
    journalctl -u "$SERVICE" -n "$lines" --no-pager
    ;;

  *)
    die "Usage: kaamwala-ctl activate-sha | activate | set-env | restart | status | logs [count]"
    ;;
esac
